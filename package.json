{
  "name": "shrike-startos",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos test",
    "check": "tsc --noEmit",
    "test": "ncc build test/config-merge.test.ts -o build/test -m && node --test build/test/index.js"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "tor-startos": "github:Start9Labs/tor-startos#801070530453e73f143bfce2fcfb27988b962f03"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  }
}
